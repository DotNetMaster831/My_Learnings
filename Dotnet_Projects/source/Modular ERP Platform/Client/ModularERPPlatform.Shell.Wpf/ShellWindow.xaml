<Window x:Class="ModularERPPlatform.Shell.Wpf.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ModularERPPlatform.Shell.Wpf"
        mc:Ignorable="d"
        Title="ModularERP" Height="600" Width="1000"
        Background="{StaticResource ShellBackgroundBrush}"
        Foreground="{StaticResource ShellForegroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Modular ERP Platform"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource ShellAccentBrush}"
                   Margin="0,0,0,12" />

        <!-- Module region. Plugin views compose here from Phase 1.5. -->
        <DataGrid Grid.Row="1"
                  x:Name="ModuleGrid"
                  ItemsSource="{Binding Modules}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="Transparent"
                  RowBackground="Transparent"
                  BorderThickness="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Module" Binding="{Binding DisplayName}" Width="220" />
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="160" />
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100" />
                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="120" />
                <DataGridTextColumn Header="Last error" Binding="{Binding LastError}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2"
                   Text="{Binding Status}"
                   Margin="0,12,0,0"
                   Opacity="0.7" />
    </Grid>
</Window>
